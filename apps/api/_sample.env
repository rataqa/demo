# copy this file to .env and edit the values as needed

# required
HTTP_PORT="3000"

# optional: default is "info"
LOG_LEVEL="info"

# example service to make HTTP calls
# check https://webhook.site
SERVICE_URL="https://webhook.site/[YOUR-KEY]"
SERVICE_API_KEY="12345"
SERVICE_API_KEY_HEADER="x-api-key"

# see https://www.opensanctions.org/docs/api/
OPENSANCTIONS_BASE_URL="https://api.opensanctions.org"
OPENSANCTIONS_API_KEY="YOUR-API-KEY"
